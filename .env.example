# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# QR_TOKEN_SECRET: HMAC secret used to cryptographically sign and verify table QR tokens.
QR_TOKEN_SECRET=

# PAYMENT_WEBHOOK_SECRET: HMAC secret used to verify payment gateway webhooks.
PAYMENT_WEBHOOK_SECRET=
